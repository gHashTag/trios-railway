<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fleet-guardian</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.10</string>
        <string>/Users/playra/trios-railway/scripts/fleet_guardian.py</string>
        <string>--env</string>
        <string>/Users/playra/trios-railway/.env</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/tmp/fleet_guardian.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fleet_guardian.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
